FROM ubuntu:24.04
# Install standard runtime dependencies for LLVM / wasm-ld (libedit2, libxml2)
RUN apt-get update && apt-get install -y libedit2 libxml2 && rm -rf /var/lib/apt/lists/*

COPY sandbox-entrypoint.sh /usr/local/bin/sandbox-entrypoint
ENTRYPOINT ["/bin/sh", "/usr/local/bin/sandbox-entrypoint"]
